# Supabase — Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — Project Settings -> API Keys -> publishable key (sb_publishable_...).
# On older projects this slot is the legacy "anon" / public key instead; both
# work here. Never put the secret or service_role key in a NEXT_PUBLIC_ variable
# — it bypasses Row Level Security and would ship to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=
